#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/src/halla.ico"

1 VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName",      "Halla-DEV"
            VALUE "FileDescription",  "Halla - Cliente de comunicação de voz"
            VALUE "FileVersion",      "@HALLA_VERSION@"
            VALUE "InternalName",     "Halla"
            VALUE "LegalCopyright",   "© 2026 Halla-DEV"
            VALUE "OriginalFilename", "Halla.exe"
            VALUE "ProductName",      "Halla"
            VALUE "ProductVersion",   "@HALLA_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
